# Copy this file to .env and replace the values locally.
# Never commit the real .env file or production credentials.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Production backend security (local migration için false bırakılabilir)
KEYCLOAK_ISSUER=https://auth.example.com/realms/ats
KEYCLOAK_AUDIENCE=ats-backend
KEYCLOAK_REQUIRED=true

# Backend-only Keycloak Admin API client (never expose or commit the secret)
KEYCLOAK_ADMIN_API_ENABLED=false
KEYCLOAK_ADMIN_SERVER_URL=http://localhost:8081
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=ats-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_REALM=ats
KEYCLOAK_COMPANY_ADMIN_ROLE=COMPANY_ADMIN
